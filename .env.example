# ==========================================
# KingxTech VTU Server Environment Variables
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
APP_ENV=sandbox

# Database (PostgreSQL / Supabase Transaction Pooler)
# Format: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kingxtech_vtu

# Authentication (Supabase / KingxTech JWT Secret)
SUPABASE_JWT_SECRET=development_jwt_secret_min_32_characters_long_12345
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key

# VTU Provider Integrations (Strictly isolated in Sandbox)
VTU_PROVIDER_DEFAULT=mock
VTU_MOCK_SIMULATE_LATENCY_MS=100
VTU_MOCK_SUCCESS_RATE=1.0

# Real VTU credentials (Ignored when VTU_PROVIDER_DEFAULT=mock)
# VTPASS_API_KEY=
# VTPASS_SECRET_KEY=
# CLUBKONNECT_API_KEY=
